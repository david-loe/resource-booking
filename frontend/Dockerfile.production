FROM node:26.12.1-alpine AS build-stage

# install nginx
RUN apk add nginx

COPY frontend/nginx.conf /etc/nginx/nginx.conf

WORKDIR /app

COPY frontend/package*.json ./

RUN npm install --global npm@12.2.1 && npm ci

COPY frontend/ .

COPY locales ./src/locales

ENTRYPOINT [ "/bin/sh", "-c" ]

CMD ["npm run build && nginx -g 'daemon off;'"]
